<%- include('../cabecalho')%>
    <div>
        <tr><a href="/categoria"> ← Voltar </a></tr>
        <h3>Atualizar Categoria</h3>

        <form method="post">
            <p>ID </p>
            <input type="text" name="id" value="<%=categoria.id%>" readonly>
            <br><br>
            <p>Categoria</p>
            <input type="text" name="nome" value="<%=categoria.nome%>">
            <br><br>
            <p>Descrição</p>
            <input type="text" name="periodo" value="<%=categoria.descricao%>">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>

    </body>

    </html>