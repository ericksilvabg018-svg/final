<%- include('../cabecalho')%>
    <div>
        <tr><a href="/categoria"> ← Voltar </a></tr>
        <h3>Nova Categoria</h3>

        <form method="post" enctype="multipart/form-data">
            <p>Nome</p>
            <input type="text" placeholder="Ex: Hatch, Sedan, Suv..." name="nome">
            <br><br>
            <p>Descrição</p>
            <input type="text" name="descricao" placeholder="Ex: carros luxuosos" name="periodo">
            <p>foto</p>
            <input type="file" name="foto" accept="image/png">
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>

    </body>

    </html>