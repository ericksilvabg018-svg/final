<%- include('../cabecalho')%>


    <div>
        <tr><a href="/mecanico"> ← Voltar </a></tr>
        <h3>Novo Mecanico</h3>


        <form method="post">
            <p>Nome</p>
            <input type="text" name="nome" placeholder="nome" required>
            <br>
            <p>Idade</p>
            <input type="number" name="idade" placeholder="idade" required>
            <br>
            <p>Experiencia</p>
            <input type="text" name="experiencia" placeholder="experiencia, ex: 5" required>
            <br><br>
            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>
        </form>
    </div>
    </body>

    </html>