<%- include('../cabecalho')%>
    <div>
        <a href="/paleontologo">← Voltar</a>
        <h3>Alterar Mecanico</h3>
        <form method="post"="/mecanico/upd/<%= mecanico.id %>">
            <p>Nome</p>
            <input type="text" name="nome" value="<%= mecanico.nome %>" required>
            <p>Idade (ano)</p>
            <input type="number" name="idade" value="<%= mecanico.idade %>" required>
            <p>Experiencia</p>
            <input type="text" name="experiencia" value="<%= mecanico.experiencia %>" required>
            <br><br>
            <button type="submit">Salvar</button>
            <button type="reset">Cancelar</button>
        </form>

    </div>
    </body>

    </html>
    <button> type="reset">Cancelar</button>
    </form>